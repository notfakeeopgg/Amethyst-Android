<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or not? -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="android:colorBackground">@color/background_app</item>
        <item name="android:windowBackground">@color/background_app</item>
        <item name="android:alertDialogTheme">@style/ParrotDialogTheme</item>
        <item name="alertDialogTheme">@style/ParrotDialogTheme</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>

        <item name="android:textSize">@dimen/_12ssp</item>

    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <!-- Parrot Client UI styles -->
    <style name="ParrotNav">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">@dimen/_12sdp</item>
        <item name="android:paddingVertical">@dimen/_6sdp</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="ParrotChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">@dimen/_8sdp</item>
        <item name="android:paddingHorizontal">@dimen/_12sdp</item>
        <item name="android:paddingVertical">@dimen/_6sdp</item>
        <item name="android:background">@drawable/bg_chip_brown</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:drawablePadding">@dimen/_6sdp</item>
        <item name="android:drawableTint">@color/accent_warm</item>
    </style>

    <style name="ParrotCatChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">@dimen/_4sdp</item>
        <item name="android:paddingHorizontal">@dimen/_4sdp</item>
        <item name="android:paddingVertical">@dimen/_8sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_chip_brown</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">@dimen/_11ssp</item>
    </style>

    <style name="ParrotToolButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/_48sdp</item>
        <item name="android:layout_margin">@dimen/_4sdp</item>
        <item name="android:background">@drawable/bg_chip_brown</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:drawablePadding">@dimen/_6sdp</item>
        <item name="android:drawableTint">@color/accent_warm</item>
    </style>

    <style name="ParrotServerRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">@dimen/_8sdp</item>
        <item name="android:paddingHorizontal">@dimen/_8sdp</item>
        <item name="android:background">@drawable/bg_server_item</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="ParrotServerRank">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/accent_warm</item>
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:layout_marginEnd">@dimen/_8sdp</item>
    </style>
    <style name="ParrotServerIcon">
        <item name="android:layout_width">@dimen/_28sdp</item>
        <item name="android:layout_height">@dimen/_28sdp</item>
        <item name="android:layout_marginEnd">@dimen/_8sdp</item>
    </style>
    <style name="ParrotServerText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="ParrotServerName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">@dimen/_13ssp</item>
    </style>
    <style name="ParrotServerIp">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">@dimen/_11ssp</item>
    </style>
    <style name="ParrotServerPlayers">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/status_online</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <!-- Parrot Client brown dialog + preference theming -->
    <style name="ParrotDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@drawable/bg_card_brown</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textColorAlertDialogListItem">@color/primary_text</item>
        <item name="android:buttonBarButtonStyle">@style/ParrotDialogButton</item>
        <item name="colorAccent">@color/accent_warm</item>
    </style>
    <style name="ParrotDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/accent_warm</item>
    </style>
</resources>
